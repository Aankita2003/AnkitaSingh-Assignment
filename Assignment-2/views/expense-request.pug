//- ==========================================================================
//- views/expense-request.pug
//- Medical & Travel Expense Request.
//-
//- Notice how short this template is: every section of the form is rendered
//- by the SAME +expenseSection mixin looping over `data.sections` supplied
//- by the backend. Adding a seventh section would require zero template
//- changes — only a new entry in data/expenseData.js.
//- ==========================================================================
extends layout

block content
  //- Demo control (hidden in print): switch simulated datasets
  +datasetSwitcher('/expense-request', datasetId)

  .sheet
    //- Shared header mixin (also used by the Progress Report)
    +docHeader('Medical & Travel Expense Request', data.claimNo)

    +introLine(data.claimant, 'requested reimbursement for the following medical and/or travel expenses:')

    main.form-body
      //- ONE loop renders all six tables — columns + rows come from backend
      each section in data.sections
        +expenseSection(section)

      //- Privacy acknowledgement, shown as already-confirmed backend data
      .privacy-row
        .cert-check
          span.mark.check.on
          span
            | I understand that the
            = ' '
            span.privacy-link Privacy Notice
            = ' '
            | applies to the personal information collected in this document.

    //- Shared footer mixin — print CSS keeps it at the bottom of the last
    //- A4 page whether the tables are short (dataset 1) or long (dataset 2)
    +docFooter(data.workerAppId, data.submittedAt)
