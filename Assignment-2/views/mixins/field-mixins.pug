//- ==========================================================================
//- mixins/field-mixins.pug
//- Field-level building blocks. Everything renders READ-ONLY — values come
//- from the simulated backend, so no editable inputs are emitted.
//- ==========================================================================

//- Underlined value with a small caption beneath it (mimics the PDF's
//- "___________ / Date" style fields). Empty values render a blank line.
//- @param value    value from backend (may be empty string)
//- @param caption  small grey caption under the line, e.g. 'Date'
mixin underlineValue(value, caption)
  span.field-block
    span.field-underline(class=(value ? '' : 'empty'))= value || '\u00a0'
    if caption
      span.field-cap= caption

//- Radio-style option rendered read-only: a filled dot when selected.
//- Any block content passed to the mixin renders inside the label
//- (used when the option text itself embeds an underlineValue).
//- @param selected  boolean — is this the chosen option?
//- @param text      plain option text (optional if block content given)
mixin optionRadio(selected, text)
  .option(class=(selected ? 'selected' : ''))
    span.mark.radio(class=(selected ? 'on' : ''))
    span.opt-text
      if text
        = text
      block

//- Checkbox-style option rendered read-only: a ticked box when checked.
mixin optionCheck(checked, text)
  .option(class=(checked ? 'selected' : ''))
    span.mark.check(class=(checked ? 'on' : ''))
    span.opt-text
      if text
        = text
      block

//- Bordered box with a small label — the standard container for the
//- Worker Progress Report questions.
mixin questionBox(label)
  .box
    if label
      .box-label= label
    block

//- Read-only free-text area (replaces the textarea from Assignment 1).
mixin freeText(value)
  .free-text(class=(value ? '' : 'empty'))= value || '\u00a0'

//- Pain scale 1-10 rendered as read-only radio marks with captions.
//- @param level  number 1..10, or null when unanswered
mixin painScale(level)
  .pain-scale
    - for (let n = 1; n <= 10; n++)
      span.pain-opt
        span.mark.radio(class=(level === n ? 'on' : ''))
        span= n
  .pain-caption
    span No pain
    span Severe pain

//- ==========================================================================
//- Generic data table — renders ANY of the six expense sections from a
//- single definition ({ columns, rows }). This is the core reusability
//- mixin: one template loop drives every table in the form.
//- @param section  { title-agnostic: columns:[{label,key,align?}], rows:[{}] }
//- ==========================================================================
mixin dataTable(section)
  .table-wrap
    table.data-table
      thead
        tr
          each col in section.columns
            th(class=(col.align === 'right' ? 'align-right' : ''))= col.label
      tbody
        if section.rows.length
          each row in section.rows
            tr
              each col in section.columns
                td(class=(col.align === 'right' ? 'align-right' : ''))= row[col.key] || '—'
        else
          //- Graceful empty state when a dataset has no rows for a section
          tr.empty-row
            td(colspan=section.columns.length) No entries submitted for this section.

//- Full expense section = banner + optional note + table, in one call.
//- Demonstrates mixins composing other mixins (modularity WITHIN the form).
mixin expenseSection(section)
  section.form-section
    +sectionTitle(section.title, section.asterisk)
    if section.note
      +noteText(section.note)
    +dataTable(section)
