//- ==========================================================================
//- views/progress-report.pug
//- Worker Progress Report.
//-
//- Reuses the SAME layout mixins as the expense form (docHeader, introLine,
//- sectionTitle, docFooter, datasetSwitcher) plus the field mixins for
//- read-only radios, checkboxes, underlined values and free text.
//- ==========================================================================
extends layout

block content
  //- Local shorthands for the two backend sub-objects
  - const rtw = data.returnToWork
  - const rec = data.recovery

  +datasetSwitcher('/progress-report', datasetId)

  .sheet
    //- 'WP' code box appears via the optional third argument
    +docHeader('Worker Progress Report', data.claimNo, data.formCode)

    +introLine(data.claimant, 'provided the following updates in relation to their claim:')

    main.form-body

      //- ================= RETURN TO WORK =================
      +sectionTitle('Return to Work')

      +questionBox('Select one:')
        .option-row
          +optionRadio(rtw.missedTime === 'notMissed', 'I have not missed time from work')
          +optionRadio(rtw.missedTime === 'notReturned', 'I have not returned to work')
          +optionRadio(rtw.missedTime === 'returned')
            | I returned to work on:
            = ' '
            +underlineValue(rtw.returnedOnDate, 'Date')

      +questionBox('I am working:')
        .option-row
          //- The five working-arrangement checkboxes come from one array,
          //- rendered by a loop instead of five copies of the markup
          each opt in ['Full duties, regular hours', 'Full duties, reduced hours', 'Modified duties, regular hours', 'Modified duties, reduced hours']
            +optionCheck(rtw.working.includes(opt), opt)
          +optionCheck(!!rtw.workingOther)
            | Other:
            = ' '
            +underlineValue(rtw.workingOther)

      +questionBox('My return to work is going:')
        +freeText(rtw.rtwGoing)

      .two-col-question
        span I expect to return to work on:
        +underlineValue(rtw.expectedReturnDate, 'Date')

      +questionBox('I have the following concerns about returning to work:')
        +freeText(rtw.concerns)

      .two-col-question
        span I was most recently in contact with:
        +underlineValue(rtw.employerContact.name, '(Name of employer contact)')
        span on
        +underlineValue(rtw.employerContact.date, 'Date')

      //- ================= RECOVERY =================
      +sectionTitle('Recovery')

      +questionBox('Select one:')
        .option-row
          +optionRadio(rec.recovered === false, 'I have not fully recovered from my workplace injury.')
          +optionRadio(rec.recovered === true, 'I have fully recovered from my workplace injury.')

      +questionBox('I have provided the following comments about my recovery:')
        +freeText(rec.comments)

      +questionBox('I rate my current pain/discomfort on a scale of 1-10, where 1 is no pain and 10 is severe pain.')
        +painScale(rec.painLevel)

      +questionBox('Select one:')
        .option-row
          +optionRadio(rec.receivingTreatment === false, 'I am not continuing to receive medical treatment for my workplace injury.')
          +optionRadio(rec.receivingTreatment === true)
            | I am continuing to receive medical treatment for my workplace injury from:
            = ' '
            +underlineValue(rec.treatmentProviderType, '(Medical Provider Type)')
        .grid-two
          .two-col-question.tight
            span My last medical treatment was from
            +underlineValue(rec.lastTreatmentDate, 'Date')
          .two-col-question.tight
            +underlineValue(rec.lastTreatmentProviderName, '(Medical Provider Name)')
        .two-col-question.tight
          span I am attending a Chiropractor or Physiotherapist
          +underlineValue(rec.physioFrequency, '(Frequency)')

      +questionBox('Select one:')
        .option-row
          +optionRadio(rec.takingMedication === false, 'I am not taking medication for my workplace injury.')
          +optionRadio(rec.takingMedication === true)
            | I am taking medication for my workplace injury:
            = ' '
            +underlineValue(rec.medicationName, '(Name of prescribed medication)')
        .two-col-question.tight
          span My next medical treatment is
          +underlineValue(rec.nextTreatmentDate, 'Date')

      +questionBox('Select one:')
        .option-row
          +optionRadio(rec.doingHomeExercises === false, 'I am not doing home exercises for my workplace injury.')
          +optionRadio(rec.doingHomeExercises === true, 'I am doing home exercises for my workplace injury.')
        .sub-question
          .box-label List the exercises you are doing:
          +freeText(rec.exercises)

      //- ================= OTHER INFORMATION =================
      +sectionTitle('Other Information')

      +questionBox('I would like to provide the following additional information about my claim/injury:')
        +freeText(data.otherInfo)

      //- Certification block with the read-only confirmation tick
      .cert-box
        | I certify that the information given on this form is true, correct and complete to the best of my knowledge.
        | I agree to notify the Workers Compensation Board of Manitoba (WCB) immediately once I return to any form of
        | work and/or employment. I understand that it is an offence to knowingly make a false statement to the WCB.
        | I also understand that it is an offence to withhold information from WCB which affects my entitlement to
        | compensation (e.g., full or partial recovery from injury, ability to return to work, sources of additional
        | income, etc.). I understand that refusing to co-operate with, or follow my treatment, may result in the WCB
        | reducing or suspending my benefits. I understand that the Privacy Notice applies to the personal information
        | collected in this document.
        .cert-check
          span.mark.check(class=(data.certified ? 'on' : ''))
          span I certify that the information provided is true, correct, and complete.

    +docFooter(data.workerAppId, data.submittedAt)
